# Browser origin and Server bind. Production Compose derives BASE_URL from
# AISUMMONER_HOSTNAME and binds the Server only inside the private Docker net.
AISUMMONER_HOSTNAME=aisummoner.example.com
AISUMMONER_BASE_URL=http://127.0.0.1:8080
AISUMMONER_LISTEN_ADDR=127.0.0.1:8080
# Direct binary development trusts no proxy. Compose overrides this with the
# exact deterministic Caddy address below; never configure a CIDR or hostname.
AISUMMONER_TRUSTED_PROXY_IPS=
AISUMMONER_DATA_DIR=./data
AISUMMONER_DEV_MODE=1

# Required only while bootstrapping the first administrator. Remove it from the
# runtime environment after the administrator has been created.
AISUMMONER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Generate independent values, for example: openssl rand -base64 48.
# SESSION_SECRET is a validated Baseline-0 compatibility/reserved value; MVP
# Web sessions use independent random opaque tokens and store only SHA-256
# digests, so they are not derived from this value.
AISUMMONER_SESSION_SECRET=replace-with-at-least-32-random-bytes-session-secret
AISUMMONER_PAIRING_SECRET=replace-with-at-least-32-random-bytes-pairing-secret

# `fake` is deterministic and ignores every provider-only value below.
# `deepseek` requires a freshly rotated API key and explicit model, but no
# OpenCode sidecar/profile. `opencode` requires every OpenCode/Bridge value and
# a private workspace root.
AISUMMONER_AGENT_ADAPTER=fake
# Set COMPOSE_PROFILES=opencode exactly when the adapter is opencode. Keep it
# empty for both fake and deepseek.
COMPOSE_PROFILES=

AISUMMONER_DEEPSEEK_URL=https://api.deepseek.com
AISUMMONER_DEEPSEEK_API_KEY=
AISUMMONER_DEEPSEEK_MODEL=

AISUMMONER_AGENT_WORKSPACE_ROOT=/var/lib/aisummoner/workspaces
AISUMMONER_OPENCODE_URL=http://127.0.0.1:4096
AISUMMONER_OPENCODE_USERNAME=
AISUMMONER_OPENCODE_PASSWORD=
AISUMMONER_OPENCODE_MODEL=
AISUMMONER_AGENT_BRIDGE_LISTEN_ADDR=127.0.0.1:4097
AISUMMONER_OPENCODE_BRIDGE_URL=http://127.0.0.1:4097/internal/opencode/remote-exec
AISUMMONER_AGENT_BRIDGE_SECRET=

# OpenCode mode always builds the fixed local aisummoner-opencode:1.18.11
# image from deploy/OpenCode.Dockerfile; there is no image override in MVP.
AISUMMONER_IMAGE_TAG=mvp0
AISUMMONER_EDGE_SUBNET=172.30.0.0/24
AISUMMONER_SERVER_EDGE_IP=172.30.0.10
AISUMMONER_CADDY_EDGE_IP=172.30.0.20

# Remote Client systemd EnvironmentFile example:
# AISUMMONER_SERVER_URL=https://aisummoner.example.com
