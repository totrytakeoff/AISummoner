#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$app_dir/usr/lib/qt6/plugins"

if [ "${1:-}" = "--cli" ]; then
  shift
  exec "$app_dir/usr/bin/aisummoner-client" "$@"
fi

exec "$app_dir/usr/bin/aisummoner-client-ui" "$@"
